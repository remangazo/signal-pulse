# App
APP_NAME=SignalPulse
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://signalpulse:signalpulse@localhost:5432/signalpulse
DATABASE_URL_SYNC=postgresql://signalpulse:signalpulse@localhost:5432/signalpulse

# LLM (elige uno o usa llm_provider para alternativas)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Multi-proveedor LLM (opcional, reemplaza las keys de arriba)
# Proveedores: gemini (default), groq, openrouter, openai, deepseek, together
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_or_openrouter_api_key
# LLM_MODEL=llama-3.3-70b-versatile  # depende del proveedor

# Auth
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Apify
APIFY_API_KEY=your_apify_api_key_here

# Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Telegram (notifications)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
